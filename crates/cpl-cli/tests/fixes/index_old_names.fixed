let h: 1..=9 = read()
let w: 1..=9 = read()
domain Row = 1..=h
domain Col = 1..=w

struct Cell:
    r: Row
    c: Col

impl Index for Cell:
    let count = h * w
    @get fn ord(self) -> Int = r.ord * w + c.ord
    fn nth(i: Int) -> Cell = Cell(Row.nth(i / w), Col.nth(i % w))

var dist: [Cell]Int = 0
for x in Cell:
    dist[x] = x.r.label * 10 + x.c.label
let last = Cell(Row.last!, Col.last!)
print(Cell.count, dist[last], last.ord, Cell.nth(1).c)
print(dist)
