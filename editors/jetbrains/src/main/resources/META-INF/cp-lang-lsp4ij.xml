<idea-plugin>
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="cpl" name="CP Lang" factoryClass="dev.cplang.ide.CpLsp4ijFactory">
            <description><![CDATA[CP Lang's language server, <code>cpl lsp</code>.]]></description>
        </server>
        <languageMapping language="CP" serverId="cpl" languageId="cp"/>
    </extensions>
    <actions>
        <action id="cpl.exec" class="dev.cplang.ide.CplExecAction" text="CP Lang: Run a Code Lens"/>
    </actions>
</idea-plugin>
