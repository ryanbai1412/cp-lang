<idea-plugin>
    <id>dev.cplang.ide</id>
    <name>CP Lang</name>
    <vendor>CP Lang</vendor>
    <description><![CDATA[
    CP Lang, a language for competitive programming. Highlighting, run configurations for
    <code>cpl run</code>, <code>cpl test</code> and <code>cpl stress</code>, the trace viewer, and importing a problem
    from Competitive Companion;
    diagnostics, hover, completion, signature help, go to definition, rename, quick fixes and
    inlay hints come from the compiler's own language server, <code>cpl lsp</code>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- `cpl lsp` through LSP4IJ in every IDE, which `cpl setup jetbrains` installs. -->
    <depends config-file="cp-lang-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="CP Lang" implementationClass="dev.cplang.ide.CpFileType" fieldName="INSTANCE"
                  language="CP" extensions="cp"/>
        <lang.parserDefinition language="CP" implementationClass="dev.cplang.ide.CpParserDefinition"/>
        <lang.syntaxHighlighterFactory language="CP" implementationClass="dev.cplang.ide.CpSyntaxHighlighterFactory"/>
        <lang.commenter language="CP" implementationClass="dev.cplang.ide.CpCommenter"/>
        <lang.braceMatcher language="CP" implementationClass="dev.cplang.ide.CpBraceMatcher"/>
        <colorSettingsPage implementation="dev.cplang.ide.CpColorSettingsPage"/>
        <applicationConfigurable parentId="tools" instance="dev.cplang.ide.CplConfigurable"
                                 id="dev.cplang.settings" displayName="CP Lang"/>
        <notificationGroup id="CP Lang" displayType="BALLOON"/>
        <toolWindow id="CP Lang Trace" anchor="right" canCloseContents="true" factoryClass="dev.cplang.ide.CplTraceWindow"/>
        <editorNotificationProvider implementation="dev.cplang.ide.CpLightEditNotice"/>
    </extensions>
</idea-plugin>
