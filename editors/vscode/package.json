{
  "name": "cp-lang",
  "displayName": "CP Lang",
  "description": "CP Lang 0.2.2 syntax highlighting, contest snippets, cpl lsp integration, inlay hints, live sample overlays, and stress/trace commands.",
  "version": "0.3.0",
  "publisher": "cp-lang",
  "icon": "icon.png",
  "homepage": "https://cp-lang.org/setup/",
  "bugs": {
    "url": "https://github.com/ryanbai1412/cp-lang/issues"
  },
  "keywords": [
    "competitive programming",
    "codeforces",
    "atcoder",
    "cp",
    "cpl"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "private": true,
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanbai1412/cp-lang.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode CP Lang highlights .cp files but does not run `cpl`; trust the folder for diagnostics, completion and runs.",
      "restrictedConfigurations": ["cp.server.path", "cp.server.args", "cp.stress.args"]
    }
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "cp",
        "aliases": [
          "CP Lang",
          "cp"
        ],
        "extensions": [
          ".cp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cp",
        "scopeName": "source.cp",
        "path": "./syntaxes/cp.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.cp": "cp"
        }
      }
    ],
    "snippets": [
      {
        "language": "cp",
        "path": "./snippets/cp.json"
      }
    ],
    "commands": [
      {
        "command": "cp.runSample",
        "title": "Run on a Sample",
        "category": "CP"
      },
      {
        "command": "cp.runAllSamples",
        "title": "Run on All Samples",
        "category": "CP"
      },
      {
        "command": "cp.stress",
        "title": "Stress Test",
        "category": "CP"
      },
      {
        "command": "cp.submit",
        "title": "Submit: Build for the Judge and Check the Samples",
        "category": "CP"
      },
      {
        "command": "cp.addTest",
        "title": "Add a Test from the Selection or Clipboard",
        "category": "CP"
      },
      {
        "command": "cp.importProblem",
        "title": "Import a Problem from Competitive Companion",
        "category": "CP"
      },
      {
        "command": "cp.trace",
        "title": "Trace a Sample",
        "category": "CP"
      },
      {
        "command": "cp.debug",
        "title": "Debug File",
        "category": "CP"
      },
      {
        "command": "cp.replayCall",
        "title": "Replay This Call",
        "category": "CP"
      },
      {
        "command": "cp.toggleLiveValues",
        "title": "Toggle Live Sample Values",
        "category": "CP"
      },
      {
        "command": "cp.clearOverlays",
        "title": "Clear Sample Values and Counterexample",
        "category": "CP"
      },
      {
        "command": "cp.restartServer",
        "title": "Restart the Language Server",
        "category": "CP"
      },
      {
        "command": "cp.showOutput",
        "title": "Show Output",
        "category": "CP"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cp.runSample",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.runAllSamples",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.stress",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.submit",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.addTest",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.trace",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.debug",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.toggleLiveValues",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.clearOverlays",
          "when": "editorLangId == cp"
        },
        {
          "command": "cp.replayCall",
          "when": "debugType == cp && inDebugMode"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "cp.replayCall",
          "when": "debugType == cp && callStackItemType == 'stackFrame'",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "cp",
        "label": "CP Lang",
        "languages": [
          "cp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the `.cp` file to debug.",
                "default": "${file}"
              },
              "input": {
                "type": "string",
                "description": "Optional path to an input file (e.g. a sample or failing judge input)."
              },
              "inputText": {
                "type": "string",
                "description": "Optional inline stdin text to feed to the program."
              },
              "recordSteps": {
                "type": "integer",
                "description": "Optional: how many steps one recording keeps (default 10000000). A longer run is stepped through in windows of a tenth of this."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first recorded step on entry.",
                "default": true
              },
              "brute": {
                "type": "boolean",
                "description": "Debug the file's `@alt(program)` function instead of the solution.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cp",
            "request": "launch",
            "name": "Debug CP Lang File",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "cp"
      }
    ],
    "configurationDefaults": {
      "[cp]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "cp-lang.cp-lang"
      }
    },
    "configuration": {
      "title": "CP Lang",
      "properties": {
        "cp.server.path": {
          "type": "string",
          "default": "cpl",
          "scope": "machine-overridable",
          "markdownDescription": "The `cpl` binary. A bare name is looked up on `PATH`, then in the workspace's `target/release` and `target/debug`."
        },
        "cp.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "scope": "machine-overridable",
          "markdownDescription": "Arguments that start the language server. The server speaks LSP on stdio."
        },
        "cp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server."
        },
        "cp.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Run, Stress and Trace lenses above the file, its samples and its `@alt`/`@check`/`@interactor` functions."
        },
        "cp.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type inlay hints for unannotated bindings and domain loops when `cpl lsp` does not provide its own."
        },
        "cp.liveValues.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "After each save, run the file on `#cp.liveValues.input#` and show the value of each top-level `let` at the end of its line."
        },
        "cp.liveValues.input": {
          "type": "string",
          "default": "",
          "markdownDescription": "The sample live values are computed on, such as `i1` or `1`. Empty means the file's first sample."
        },
        "cp.liveValues.maxLength": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "description": "Longest value shown inline before it is cut; the full value is in the hover."
        },
        "cp.submit.copy": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Copy the C++ to the clipboard when `CP: Submit` finds it ready to send (`cpl submit --copy`)."
        },
        "cp.stress.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra flags passed to `cpl stress` (for example `[\"--cases\", \"1000\", \"--size\", \"10\"]`)."
        },
        "cp.run.timeoutMs": {
          "type": "integer",
          "default": 10000,
          "minimum": 100,
          "description": "Kill a sample run or stress run that takes longer than this."
        },
        "cp.companion.port": {
          "type": "number",
          "default": 10043,
          "markdownDescription": "The port `CP: Import a Problem` waits on for Competitive Companion (`cpl new --listen --port`); 10043 is one the extension sends to out of the box."
        }
      }
    },
    "colors": [
      {
        "id": "cp.liveValueForeground",
        "description": "Text of a live sample value at the end of a line.",
        "defaults": {
          "dark": "#7f8c9880",
          "light": "#6a737d99",
          "highContrast": "#9da5b4",
          "highContrastLight": "#57606a"
        }
      },
      {
        "id": "cp.counterexampleBackground",
        "description": "Background of the line where the fast part first differs from the brute.",
        "defaults": {
          "dark": "#f1707026",
          "light": "#d73a4920",
          "highContrast": "#f1707040",
          "highContrastLight": "#d73a4930"
        }
      },
      {
        "id": "cp.counterexampleForeground",
        "description": "Text of the fast and brute values shown beside the first difference.",
        "defaults": {
          "dark": "#f17070",
          "light": "#cb2431",
          "highContrast": "#ff8080",
          "highContrastLight": "#a40e26"
        }
      },
      {
        "id": "cp.counterexampleAgreeForeground",
        "description": "Text beside a part whose fast and brute values agree on the counterexample.",
        "defaults": {
          "dark": "#56b97f99",
          "light": "#22863a99",
          "highContrast": "#6fdd8b",
          "highContrastLight": "#116329"
        }
      },
      {
        "id": "cp.runtimeErrorBackground",
        "description": "Background of the line where a sample run trapped at runtime.",
        "defaults": {
          "dark": "#f1707026",
          "light": "#d73a4920",
          "highContrast": "#f1707040",
          "highContrastLight": "#d73a4930"
        }
      },
      {
        "id": "cp.runtimeErrorForeground",
        "description": "Text of an inline runtime error or failed sample verdict.",
        "defaults": {
          "dark": "#f17070",
          "light": "#cb2431",
          "highContrast": "#ff8080",
          "highContrastLight": "#a40e26"
        }
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/language-data.js && tsc -p .",
    "language-data": "node scripts/language-data.js",
    "watch": "tsc -w -p .",
    "test": "npm run compile && npm run test:grammar && npm run test:unit",
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/**/*.cp\"",
    "test:unit": "node --test \"out/test/unit/*.test.js\"",
    "package": "vsce package --no-dependencies --out cp-lang.vsix",
    "vscode:prepublish": "npm run bundle",
    "bundle": "node scripts/language-data.js && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/src/extension.js --minify",
    "test:integration": "npm run compile && node out/test/integration/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.82.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-oniguruma": "^1.7.0",
    "vscode-textmate": "^7.0.4",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
