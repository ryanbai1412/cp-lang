{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CP Lang",
  "scopeName": "source.cp",
  "fileTypes": ["cp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#decorators" },
    { "include": "#strings" },
    { "include": "#chars-and-labels" },
    { "include": "#numbers" },
    { "include": "#use" },
    { "include": "#declarations" },
    { "include": "#contracts" },
    { "include": "#labels" },
    { "include": "#keyword-members" },
    { "include": "#keywords" },
    { "include": "#lambda-params" },
    { "include": "#compound-assign-words" },
    { "include": "#optional-types" },
    { "include": "#turbofish" },
    { "include": "#generics" },
    { "include": "#boundaries" },
    { "include": "#calls" },
    { "include": "#type-names" },
    { "include": "#members" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.cp",
          "match": "(///).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.cp" } }
        },
        {
          "name": "comment.line.double-slash.cp",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.cp" } }
        }
      ]
    },
    "directives": {
      "comment": "File-level directives (`@!multitest`, `@!...`) apply from this line down and are scoped distinctly from item attributes.",
      "name": "meta.directive.cp",
      "match": "(@!)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.directive.cp" },
        "2": { "name": "keyword.control.directive.cp" }
      }
    },
    "decorators": {
      "comment": "Item attributes (`@memo`, `@brute`, `@checker`, `@interactor`, `@law`, `@grader`, `@tags`, `@gen`, `@get`, `@test`, `@on_unimplemented`).",
      "name": "meta.decorator.cp",
      "match": "(@)(?!!)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.cp" },
        "2": { "name": "entity.name.function.decorator.cp" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.cp",
          "begin": "\\b(r)(\")",
          "end": "(\")|$",
          "beginCaptures": {
            "1": { "name": "storage.type.string.raw.cp" },
            "2": { "name": "punctuation.definition.string.begin.cp" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.cp" } }
        },
        {
          "name": "string.quoted.double.cp",
          "begin": "\"",
          "end": "(\")|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cp" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.cp" } },
          "patterns": [
            { "name": "constant.character.escape.cp", "match": "\\\\." },
            { "name": "constant.character.escape.brace.cp", "match": "\\{\\{|\\}\\}" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.cp",
      "contentName": "meta.embedded.line.cp",
      "begin": "\\{",
      "end": "(\\})|(?=$)",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.cp" } },
      "endCaptures": { "1": { "name": "punctuation.section.interpolation.end.cp" } },
      "patterns": [
        { "include": "#braces" },
        {
          "comment": "Format specifiers such as `:.5`, `:.6f`, `:05`, `:x`, `:b`, `:08x`, `:>10`, `:+08.3f` right before the closing brace.",
          "match": "(?<!:)(:)((?:[^:\\s{}]?[<>=^])?[+-]?#?0?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)[fFeEgGdoxXbBs%]?|(?:[^:\\s{}]?[<>=^])?[+-]?#?0?[fFeEgGdoxXbBs%])(?=\\})",
          "captures": {
            "1": { "name": "punctuation.separator.format.cp" },
            "2": { "name": "constant.other.placeholder.format.cp" }
          }
        },
        { "include": "$self" }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "(\\})|(?=$)",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.cp" } },
      "endCaptures": { "1": { "name": "punctuation.section.braces.end.cp" } },
      "patterns": [
        { "include": "#braces" },
        { "include": "$self" }
      ]
    },
    "chars-and-labels": {
      "patterns": [
        {
          "name": "string.quoted.single.char.cp",
          "match": "(')(?:(\\\\.)|[^'\\\\])(')",
          "captures": {
            "1": { "name": "punctuation.definition.string.begin.cp" },
            "2": { "name": "constant.character.escape.cp" },
            "3": { "name": "punctuation.definition.string.end.cp" }
          }
        },
        {
          "name": "entity.name.label.cp",
          "match": "'[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.integer.hexadecimal.cp", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.integer.binary.cp", "match": "\\b0[bB][01_]+\\b" },
        {
          "name": "constant.numeric.float.cp",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.cp",
          "match": "\\b[0-9][0-9_]*[eE]-[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.cp",
          "match": "\\b[0-9][0-9_]*(?:[eE]\\+?[0-9][0-9_]*)?\\b"
        }
      ]
    },
    "use": {
      "name": "meta.use.cp",
      "begin": "^\\s*(?:(pub)\\s+)?(use)\\b",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pub.cp" },
        "2": { "name": "keyword.control.import.cp" }
      },
      "patterns": [
        { "include": "#comments" },
        { "name": "keyword.control.import.as.cp", "match": "\\bas\\b" },
        { "name": "keyword.operator.glob.cp", "match": "\\*" },
        { "include": "#type-names" },
        { "name": "entity.name.namespace.cp", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "`fn peel<D>(...)`: a lowercase name, so its type parameters are matched here.",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:(<)([^<>()]*)(>))?",
          "captures": {
            "1": { "name": "storage.type.function.cp" },
            "2": { "name": "entity.name.function.cp" },
            "3": { "name": "punctuation.definition.generic.begin.cp" },
            "4": { "patterns": [{ "include": "#type-names" }, { "include": "#punctuation" }] },
            "5": { "name": "punctuation.definition.generic.end.cp" }
          }
        },
        {
          "match": "\\b(struct|enum|trait)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.cp" },
            "2": { "name": "entity.name.type.$1.cp" }
          }
        },
        {
          "match": "\\b(domain)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.domain.cp" },
            "2": { "name": "entity.name.type.domain.cp" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.alias.cp" },
            "2": { "name": "entity.name.type.alias.cp" }
          }
        },
        {
          "match": "(?<!if )\\b(const)\\s+(?!struct\\b)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.const.cp" },
            "2": { "name": "variable.other.constant.cp" }
          }
        }
      ]
    },
    "contracts": {
      "comment": "`invariant` is contextual: highlighted as a statement keyword at line start, plain name elsewhere.",
      "match": "^\\s*(invariant)\\b(?=\\s+(?![-+*/%^&|<>]*=)\\S)",
      "captures": { "1": { "name": "keyword.other.contract.invariant.cp" } }
    },
    "labels": {
      "comment": "A named argument, a parameter or a record field: `(by: min`, `, mut g: Dsu`, `(gen: () => ...)`.",
      "match": "([(,;])\\s*(?:(mut|lends)\\s+)?([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "patterns": [{ "include": "#punctuation" }] },
        "2": { "name": "storage.modifier.$2.cp" },
        "3": { "name": "variable.parameter.label.cp" },
        "4": { "name": "punctuation.separator.label.cp" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "comment": "`law name(...) = ...` declares a law; `law` is a plain name elsewhere.",
          "match": "^\\s*(law)\\s+(?=[a-z_][A-Za-z0-9_]*\\s*\\()",
          "captures": { "1": { "name": "keyword.other.law.cp" } }
        },
        {
          "comment": "`-> yields (v: V)` is a generator's return type; `yields` is a plain name elsewhere.",
          "match": "(?<=->\\s|->)(yields)\\b(?=\\s*\\()",
          "captures": { "1": { "name": "keyword.other.yields.cp" } }
        },
        {
          "comment": "`= do:` opens a block that is a value; `do` is a plain name elsewhere.",
          "match": "(?<![.A-Za-z0-9_])(do)(?=:(?:\\s*$|\\s*//))",
          "captures": { "1": { "name": "keyword.control.do.cp" } }
        },
        {
          "match": "\\b(yield)\\s+(from)\\b(?!\\s*[.(\\[]|\\s*$)",
          "captures": {
            "1": { "name": "keyword.control.yield.cp" },
            "2": { "name": "keyword.control.yield.from.cp" }
          }
        },
        {
          "comment": "`lends mut Slice<I, T>` highlights both `lends` and `mut` cleanly.",
          "match": "\\b(lends)\\s+(mut)\\b",
          "captures": {
            "1": { "name": "storage.modifier.lends.cp" },
            "2": { "name": "storage.modifier.mut.cp" }
          }
        },
        {
          "name": "keyword.control.$1.cp",
          "match": "\\b(if|elif|else|for|while|in|match|return|break|continue|assert|yield)\\b"
        },
        { "name": "keyword.operator.logical.$1.cp", "match": "\\b(and|or|not)\\b" },
        { "name": "keyword.other.unsafe.unchecked.cp", "match": "\\bunchecked\\b" },
        { "name": "storage.type.var.cp", "match": "\\bvar\\b" },
        { "name": "storage.type.let.cp", "match": "\\blet\\b" },
        { "name": "storage.type.function.cp", "match": "\\bfn\\b" },
        { "name": "storage.type.$1.cp", "match": "\\b(struct|enum|domain|type|trait|impl)\\b" },
        { "name": "keyword.control.import.cp", "match": "\\buse\\b" },
        { "name": "storage.modifier.mut.cp", "match": "\\bmut\\b" },
        { "name": "storage.modifier.lends.cp", "match": "\\blends\\b" },
        { "name": "storage.modifier.$1.cp", "match": "\\b(pub|const)\\b" },
        { "name": "variable.language.self.cp", "match": "\\bself\\b" },
        { "name": "constant.language.boolean.$1.cp", "match": "\\b(false|true)\\b" },
        { "name": "constant.language.none.cp", "match": "\\b(None|none)\\b" }
      ]
    },
    "lambda-params": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(=>)",
      "captures": {
        "1": { "name": "variable.parameter.lambda.cp" },
        "2": { "name": "keyword.operator.fat-arrow.cp" }
      }
    },
    "compound-assign-words": {
      "comment": "Tropical optional updates (`dist[v] min= dist[u] + w`, `best max= x`).",
      "name": "meta.operator.tropical.cp",
      "match": "\\b((?:min|max)=)(?!=)",
      "captures": {
        "1": { "name": "keyword.operator.assignment.compound.cp" }
      }
    },
    "optional-types": {
      "comment": "Tropical optional type prefixes (`?Int`, `?V`, `??Int`, `?[V]Int`, `?(Int, V)`).",
      "patterns": [
        {
          "name": "meta.type.optional.cp",
          "match": "(\\?+)(?=[A-Z])",
          "captures": {
            "1": { "name": "keyword.operator.optional.cp" }
          }
        },
        {
          "name": "meta.type.optional.cp",
          "match": "(?<=[:<,( \\t])(\\?+)(?=[\\[(])",
          "captures": {
            "1": { "name": "keyword.operator.optional.cp" }
          }
        },
        {
          "name": "meta.type.optional.cp",
          "match": "(?<=\\])(\\?+)(?=\\()",
          "captures": {
            "1": { "name": "keyword.operator.optional.cp" }
          }
        }
      ]
    },
    "turbofish": {
      "comment": "`f::<Int>()` and `topo::<V>(next)`.",
      "name": "meta.generic.turbofish.cp",
      "begin": "(::)(<)",
      "end": "(>)|(?=$)",
      "beginCaptures": {
        "1": { "name": "punctuation.accessor.double-colon.cp" },
        "2": { "name": "punctuation.definition.generic.begin.cp" }
      },
      "endCaptures": { "1": { "name": "punctuation.definition.generic.end.cp" } },
      "patterns": [{ "include": "$self" }]
    },
    "generics": {
      "comment": "`Name<` starts type arguments only when `Name` is capitalized and `<` touches it.",
      "name": "meta.generic.cp",
      "begin": "\\b([A-Z][A-Za-z0-9_]*)(<)(?![=<\\s])",
      "end": "(>)|(?=$)",
      "beginCaptures": {
        "1": { "patterns": [{ "include": "#type-names" }] },
        "2": { "name": "punctuation.definition.generic.begin.cp" }
      },
      "endCaptures": { "1": { "name": "punctuation.definition.generic.end.cp" } },
      "patterns": [{ "include": "$self" }]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.cp",
          "match": "(?<![.A-Za-z0-9_])(lyndon_factorization|common_prefix_len|common_suffix_len|next_permutation|prev_permutation|ternary_max_real|ternary_min_real|floor_quotients|partition_point|prefix_function|floyd_warshall|is_subsequence|get_or_insert|rotated_right|bsearch_real|cyclic_pairs|kruskal_tree|min_rotation|rotate_right|rotated_left|equal_range|is_some_and|max_closure|read_output|rotate_left|starts_with|ternary_max|ternary_min|drop_while|inversions|is_none_or|split_best|take_while|z_function|adjacency|bit_width|ends_with|is_sorted|laws_hold|partition|reachable|read_line|adjacent|and_then|bit_ceil|ceil_div|compress|condense|convolve|dijkstra|distinct|divisors|find_all|first_gt|flat_map|manacher|popcount|read_all|bit_len|buckets|choose2|deduped|flatten|inverse|iterate|kruskal|last_lt|pow_mod|reverse|shuffle|undoing|windows|aliens|chunks|counts|digits|divmod|insert|locate|minmax|period|prefix|reduce|remove|repeat|select|sorted|to_str|atan2|chain|count|debug|dedup|digit|first|fixed|floor|flush|group|hypot|isqrt|log10|lower|pairs|print|round|tally|track|trunc|upper|acos|adj4|adj8|asin|atan|cbrt|ceil|copy|desc|each|eval|find|fold|log2|peel|prod|rand|read|runs|scan|sign|some|sort|span|sqrt|step|swap|topo|turn|abs|all|any|ask|bfs|bit|cmp|cos|ctz|dfs|exp|gcd|gen|lcm|len|lis|max|min|phi|ray|scc|sin|sum|tan|yes|zip|ln)(?=\\s*\\(|::<)"
        },
        {
          "name": "support.function.stdlib.cp",
          "match": "(?<![.A-Za-z0-9_])(max_weight_general_matching|stable_partition_in_place|convex_polygon_intersect|convex_polygons_overlap|circle_circle_tangents|any_segments_meet_idx|circle_line_intersect|divisors_from_factors|point_location_planar|half_plane_intersect|line_plane_intersect|matroid_intersection|min_cost_circulation|min_enclosing_circle|sieve_multiplicative|circle_polygon_area|hull_line_intersect|max_weight_matching|min_weight_matching|polygon_triangulate|sample_points_shift|two_edge_components|circle_circle_area|circles_union_area|continued_fraction|convex_hull_3d_idx|dirichlet_convolve|get_or_insert_with|linear_diophantine|partition_in_place|polyhedron_volume6|sum_multiplicative|any_segments_meet|find_all_wildcard|linear_congruence|segment_intersect|suffix_tree_edges|unimodality_break|berlekamp_massey|chromatic_number|circle_intersect|fixed_cost_paths|general_matching|max_bounded_flow|min_bounded_flow|min_bounding_box|min_mod_in_range|min_vertex_cover|mo_order_hilbert|parallel_bsearch|polygon_centroid|ray_hits_segment|rects_union_area|sorted_intersect|split_whitespace|bernoulli_table|circle_tangents|concavity_break|convex_hull_idx|convexity_break|minkowski_lower|minkowski_upper|mo_with_updates|monotone_minima|partial_inverse|partition_table|spanning_forest|stable_matching|block_cut_tree|cartesian_tree|convex_hull_3d|global_min_cut|is_permutation|line_intersect|lower_hull_idx|min_mean_cycle|negative_cycle|polygon_kernel|prefix_matches|primitive_root|transposed_mul|upper_hull_idx|adjacent_diff|angle_between|best_matching|best_rational|chunks_padded|closest_pair2|counting_sort|dirichlet_inv|edge_coloring|farthest_pair|hull_tangents|is_palindrome|locate_convex|manhattan_mst|masks_of_size|minkowski_sum|pick_boundary|pick_interior|recurrence_at|segments_meet|smallest_topo|spanning_tree|stirling1_col|stirling1_row|stirling2_col|stirling2_row|voronoi_cells|arborescence|bellman_ford|circumcenter|closest_pair|combinations|convolve_all|cut_vertices|each_divisor|gallop_first|hull_extreme|inverse_real|max_matching|max_rotation|merge_sorted|mod_kth_root|next_smaller|offline_over|permutations|planar_faces|point_action|polygon_area|pow_mod_poly|prev_smaller|record_highs|sorted_union|sparse_solve|subsequences|subset_folds|suffix_array|taylor_shift|bit_subsets|bostan_mori|circulation|compose_inv|convex_hull|count_paths|differences|flip_action|from_prufer|hash_fields|index_pairs|interpolate|knuth_break|lagrange_at|lyndon_runs|mo_rollback|monge_break|monge_paths|perm_cycles|perm_unrank|poly_degree|polygon_cut|prefix_excl|prefix_fold|prime_count|prod_linear|read_fields|show_fields|sorted_diff|sphere_dist|subset_sums|suffix_fold|with_domain|angle_less|bell_table|carmichael|complement|components|dinkelbach|dominators|euler_walk|filter_map|find_cycle|first_some|first_true|hull_width|idempotent|k_shortest|kway_merge|lower_hull|max_clique|monge_path|mult_order|on_segment|perm_order|power_sums|radix_sort|reach_sets|skip_while|solve_real|sparse_det|split_once|splitmix64|subset_exp|subset_log|sum_mobius|supermasks|transposed|trim_start|upper_hull|adjacency|area2_128|backtrack|ceil_sqrt|de_bruijn|diameter2|dnc_break|dnc_layer|drop_last|eq_fields|floor_sum|gomory_hu|last_true|line_dist|lt_fields|max_count|min_count|next_same|odd_cycle|outermost|parse_int|perm_rank|perm_sign|pop_while|prev_same|primes_in|rank_real|scc_times|shift_and|symmetric|take_last|transpose|triangles|two_color|with_next|zip_exact|all_some|covering|dag_fold|decrease|delaunay|det_real|dfs_tree|eval_all|gcd_poly|guess_at|incenter|increase|integral|is_prime|lis_ends|majority|mo_order|mo_steps|mod_sqrt|perm_pow|same_dir|seg_dist|sign_eps|submasks|take_all|to_lower|to_upper|trim_end|turn_eps|arc_len|argmins|borders|boruvka|bridges|bsearch|chirp_z|closure|collect|compose|crt_all|div_mod|ext_gcd|inv_mod|johnson|lcs_all|maximal|minimal|mod_log|mul_mod|overlap|poly_at|present|product|project|reflect|replace|resized|rsearch|simplex|sum_phi|swap_at|valleys|argmax|argmin|blocks|choose|factor|filter|invert|jacobi|newton|pieces|pop_if|prufer|search|sorted|update|area2|bfs01|clone|close|cross|cycle|deriv|girth|halve|iroot|keyed|knuth|max_k|min_k|parse|rekey|rfind|smawk|spans|split|clip|dial|drop|fwht|join|mean|only|prim|push|sort|span|sqrt|take|trim|arg|cdq|crt|deg|dot|exp|inv|lcs|log|map|max|min|nth|ntt|pop|pow|sos|mo)(?=\\s*\\(|::<)"
        },
        {
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*\\(|::<)",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.cp" },
            "2": { "name": "entity.name.function.method.cp" }
          }
        },
        {
          "name": "entity.name.function.call.cp",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\(|::<)"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "support.type.builtin.cp",
          "match": "\\b(SortedRange|Interactor|HashMap|HashSet|Indexed|Subset|Range|Bool|Char|I128|Iter|List|Cut|F64|Int|Map|Seq|Set|Str|Sym|U64)\\b"
        },
        {
          "name": "support.type.stdlib.cp",
