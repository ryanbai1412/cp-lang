{
  "comment": "Generated by `cpl setup vscode --grammar` from crates/cpl-syntax's token tables.",
  "fileTypes": [
    "cp"
  ],
  "name": "CP Lang",
  "patterns": [
    {
      "match": "[ \\t\\r\\n]+"
    },
    {
      "match": "///(?!/)[^\\n]*",
      "name": "comment.line.documentation.cp"
    },
    {
      "match": "//[^\\n]*",
      "name": "comment.line.double-slash.cp"
    },
    {
      "match": "r\"[^\"\\n]*\"?",
      "name": "string.quoted.double.cp"
    },
    {
      "match": "\"(?:\\\\[^\\n]|[^\"\\n])*\"?",
      "name": "string.quoted.double.cp"
    },
    {
      "match": "'\\\\x[0-9a-fA-F]{2}'|'\\\\[^\\n]'|'[^\\n]'",
      "name": "constant.character.cp"
    },
    {
      "match": "'[\\p{L}_][\\p{L}\\p{Nd}_]*",
      "name": "entity.name.label.cp"
    },
    {
      "match": "@[\\p{L}_][\\p{L}\\p{Nd}_]*",
      "name": "entity.name.function.decorator.cp"
    },
    {
      "match": "(?\u003c=\\.)\\p{Nd}[\\p{Nd}_]*",
      "name": "constant.numeric.cp"
    },
    {
      "match": "0[xXbB][\\p{L}\\p{Nd}_]*|\\p{Nd}[\\p{Nd}_]*(?:\\.\\p{Nd}[\\p{Nd}_]*)?(?:[eE][+-]?\\p{Nd}[\\p{Nd}_]*)?",
      "name": "constant.numeric.cp"
    },
    {
      "match": "(?:true|false|None)(?![\\p{L}\\p{Nd}_])",
      "name": "constant.language.cp"
    },
    {
      "match": "(?:let|var|const|fn|struct|enum|domain|type|use|pub|if|elif|else|for|while|in|match|return|break|continue|and|or|not|assert|mut|self|unchecked|trait|impl|lends|yield)(?![\\p{L}\\p{Nd}_])",
      "name": "keyword.control.cp"
    },
    {
      "match": "\\p{Lu}[\\p{L}\\p{Nd}_]*",
      "name": "entity.name.type.cp"
    },
    {
      "match": "[\\p{L}_][\\p{L}\\p{Nd}_]*",
      "name": "variable.other.cp"
    },
    {
      "match": ",",
      "name": "punctuation.separator.comma.cp"
    },
    {
      "match": "\\.",
      "name": "punctuation.accessor.cp"
    },
    {
      "match": "\\(",
      "name": "punctuation.brackets.round.cp"
    },
    {
      "match": "\\)",
      "name": "punctuation.brackets.round.cp"
    },
    {
      "match": "\\[",
      "name": "punctuation.brackets.square.cp"
    },
    {
      "match": "\\]",
      "name": "punctuation.brackets.square.cp"
    },
    {
      "match": "\\{",
      "name": "punctuation.brackets.curly.cp"
    },
    {
      "match": "\\}",
      "name": "punctuation.brackets.curly.cp"
    },
    {
      "match": ".",
      "name": "keyword.operator.cp"
    }
  ],
  "scopeName": "source.cp"
}

