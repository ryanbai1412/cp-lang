{
  "Memoized DP (@memo)": {
    "prefix": ["memo", "@memo", "dp"],
    "body": [
      "@memo",
      "fn ${1:dp}(${2:i}: ${3:V}) -> ${4:Int}:",
      "    ${0}"
    ],
    "description": "CP Lang v2.2 @memo DP function (auto-dispatches flat vs salted hash table)"
  },
  "Binary search first true": {
    "prefix": ["bsearch_first", "bsfirst"],
    "body": [
      "let ${1:ans} = bsearch_first(${2:lo..=hi}, ${3:x} => ${4:ok(x)})"
    ],
    "description": "Find the smallest value in a range satisfying a monotone predicate"
  },
  "Binary search last true": {
    "prefix": ["bsearch_last", "bslast"],
    "body": [
      "let ${1:ans} = bsearch_last(${2:lo..=hi}, ${3:x} => ${4:ok(x)})"
    ],
    "description": "Find the largest value in a range satisfying a monotone predicate"
  },
  "Coordinate compression": {
    "prefix": ["compress", "coord"],
    "body": [
      "let ${1:xs} = compress(${2:vals})",
      "for r in ${1:xs}.D:",
      "    let v = ${1:xs}[r]",
      "    ${0}"
    ],
    "description": "Coordinate compression returning Compressed<T> with domain xs.D and xs.at(v)"
  },
  "Segment tree": {
    "prefix": ["segtree", "SegTree"],
    "body": [
      "var ${1:st} = SegTree<${2:V}, ${3:Int}>(${4|+,min,max,^,gcd|}, ${5:a})",
      "${0}"
    ],
    "description": "Domain-indexed SegTree with operator or custom Monoid"
  },
  "Segment tree with custom Monoid": {
    "prefix": ["segtree-monoid", "monoid"],
    "body": [
      "let ${1:m} = Monoid(${2:id}, (${3:a}, ${4:b}) => ${5:merge(a, b)})",
      "var ${6:st} = SegTree<${7:V}, ${8:Node}>(${1:m}, ${9:a})",
      "${0}"
    ],
    "description": "SegTree with a custom Monoid(id, op)"
  },
  "Lazy segment tree": {
    "prefix": ["lazysegtree", "LazySegTree"],
    "body": [
      "var ${1:st} = LazySegTree<${2:V}, ${3:Int}>(${4|AddSum,AddMin,AddMax,AssignSum,AssignMin,AssignMax|}, ${5:a})",
      "${0}"
    ],
    "description": "Domain-indexed LazySegTree with built-in range Action"
  },
  "Lazy segment tree with custom Action": {
    "prefix": ["lazysegtree-action", "action"],
    "body": [
      "let ${1:act} = Action(",
      "    ${2:id},",
      "    (new_f, old_f) => ${3:compose(new_f, old_f)},",
      "    (f, val, span) => ${4:apply(f, val, span)},",
      "    over: ${5|+,min,max|},",
      ")",
      "var ${6:st} = LazySegTree<${7:V}, ${8:Int}>(${1:act}, ${9:a})",
      "${0}"
    ],
    "description": "LazySegTree with v2.2 custom Action(id, compose(new_f, old_f), apply(f, val, span), over: op)"
  },
  "Sparse table": {
    "prefix": ["sparsetable", "SparseTable"],
    "body": [
      "let ${1:rmq} = SparseTable<${2:V}, ${3:Int}>(${4|min,max,gcd|}, ${5:a})",
      "${0}"
    ],
    "description": "O(1) idempotent range query SparseTable"
  },
  "Rooted tree with HLD": {
    "prefix": ["rooted", "hld", "Rooted"],
    "body": [
      "let ${1:t} = Rooted<${2:V}>(${3:g}, ${4:V.first})",
      "var ${5:st} = LazySegTree<${1:t}.Pre, ${6:Int}>(${7|AddSum,AddMin,AddMax,AssignSum,AssignMin,AssignMax|}, [${1:t}.Pre] p => ${8:a}[${1:t}.preorder[p]])",
      "// Path query: ${1:t}.fold_path(u, v, ${5:st})",
      "// Subtree query: ${5:st}.fold(${1:t}.sub(u))",
      "${0}"
    ],
    "description": "Rooted<V> tree with HLD preorder domain t.Pre and LazySegTree"
  },
  "DSU with rollback": {
    "prefix": ["dsu", "Dsu"],
    "body": [
      "var ${1:dsu} = Dsu<${2:V}>()",
      "let ${3:snap} = ${1:dsu}.mark()",
      "${0}",
      "${1:dsu}.undo_to(${3:snap})"
    ],
    "description": "Disjoint Set Union with explicit mark/undo_to rollback"
  },
  "Touched-list reset table": {
    "prefix": ["touched", "seen"],
    "body": [
      "var ${1:seen}: [${2:V}]Bool = false",
      "var ${3:touched}: List<${2:V}> = []",
      "if not ${1:seen}[${4:u}]:",
      "    ${1:seen}[${4:u}] = true",
      "    ${3:touched}.push(${4:u})",
      "// O(|touched|) reset:",
      "for u in ${3:touched}.take(): ${1:seen}[u] = false",
      "${0}"
    ],
    "description": "1-byte [V]Bool table with O(|touched|) reset for hot multi-query loops"
  },
  "Small-to-large merge": {
    "prefix": ["small-to-large", "stl"],
    "body": [
      "if ${1:dst}.len < ${2:src}.len: swap(mut ${1:dst}, mut ${2:src})",
      "for ${3:x} in ${2:src}.take():",
      "    ${0}"
    ],
    "description": "O(n log n) small-to-large merge using swap + .take()"
  },
  "Modular arithmetic + combinatorics": {
    "prefix": ["mod", "Mod", "comb"],
    "body": [
      "const MOD = ${1|998_244_353,1_000_000_007|}",
      "type Z = Mod<MOD>",
      "let comb = Comb<MOD>()",
      "${0}"
    ],
    "description": "Mod<MOD> type alias and immutable interior-mutable Comb<MOD>()"
  },
  "Multitest skeleton": {
    "prefix": ["multitest", "@multitest"],
    "body": [
      "@multitest",
      "let ${1:n}: ${2:1..=2e5} = read()",
      "domain ${3:V} = 1..=${1:n}",
      "let ${4:a}: [${3:V}]Int = read()",
      "${0}"
    ],
    "description": "Whole-file @multitest solution template"
  },
  "Constructive @checker": {
    "prefix": ["checker", "@checker"],
    "body": [
      "@checker",
      "fn check():",
      "    let ${1:ans}: ${2:Int} = read_output()",
      "    assert ${3:ok(ans)}",
      "    ${0}"
    ],
    "description": "Co-located @checker validating solution stdout with read_output() and assert"
  },
  "Interactive @interactor": {
    "prefix": ["interactor", "@interactor"],
    "body": [
      "@interactor",
      "fn judge(sol: Interactor):",
      "    let ${1:secret}: ${2:1..=1000} = read()",
      "    sol.send(${3:n})",
      "    var queries = 0",
      "    while true:",
      "        let kind: Str = sol.recv()",
      "        if kind == \"!\":",
      "            let guess: Int = sol.recv()",
      "            assert guess == ${1:secret}",
      "            return",
      "        queries += 1",
      "        assert queries <= ${4:20}",
      "        let x: Int = sol.recv()",
      "        sol.send(${0:x})",
      ""
    ],
    "description": "Co-located @interactor using explicit sol: Interactor (sol.recv / sol.send)"
  },
  "Stress test with gen: and @brute(main)": {
    "prefix": ["stress", "gen", "brute"],
    "body": [
      "let ${1:n}: ${2:1..=20} = read()",
      "domain ${3:V} = 1..=${1:n}",
      "let ${4:a}: [${3:V}]Int = read(gen: () => [${3:V}] _ => rand(1..=10))",
      "",
      "@brute(main)",
      "fn slow():",
      "    ${0}"
    ],
    "description": "Typed read(gen: ...) + @brute(main) stress-test setup"
  },
  "Whole-input @gen": {
    "prefix": ["atgen", "@gen"],
    "body": [
      "@gen",
      "fn make_case(size: Int):",
      "    let n = rand(1..=size)",
      "    print(n)",
      "    ${0}"
    ],
    "description": "Whole-input @gen generator with choice-stream shrinking"
  },
  "IOI @grader declaration": {
    "prefix": ["grader", "@grader"],
    "body": [
      "var ${1:state}: ?${2:State} = none",
      "",
      "@grader",
      "fn ${3:init}(${4:n}: Int, ${5:a}: [0..${4:n}]Int):",
      "    ${1:state} = ${2:State}(${5:a})",
      "    ${0}"
    ],
    "description": "Stateful IOI @grader entry point"
  }
}
