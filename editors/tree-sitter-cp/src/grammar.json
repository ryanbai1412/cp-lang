            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          }
        ]
      }
    },
    "call": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "function",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "("
            },
            "named": true,
            "value": "punctuation"
          }
        ]
      }
    },
    "member": {
      "type": "PREC_RIGHT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "."
            },
            "named": true,
            "value": "punctuation"
          },
          {
            "type": "FIELD",
