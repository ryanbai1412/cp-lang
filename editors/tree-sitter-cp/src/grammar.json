      "type": "PATTERN",
      "value": "[a-z_][A-Za-z0-9_]*"
    },
    "type_identifier": {
      "type": "PATTERN",
      "value": "[A-Z][A-Za-z0-9_]*"
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "..="
          },
          {
            "type": "STRING",
            "value": ".."
          },
          {
            "type": "PATTERN",
            "value": "[-+*\\/%^&|<>=!?~]+"
          }
        ]
      }
    },
    "punctuation": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
