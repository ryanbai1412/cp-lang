        },
        {
          "type": "STRING",
          "value": "or"
        },
        {
          "type": "STRING",
          "value": "not"
        },
        {
          "type": "STRING",
          "value": "assert"
        },
        {
          "type": "STRING",
          "value": "mut"
        },
        {
          "type": "STRING",
          "value": "lends"
        },
        {
          "type": "STRING",
          "value": "yield"
        },
        {
          "type": "STRING",
          "value": "unchecked"
        }
      ]
    },
    "function_definition": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "fn"
            },
            "named": true,
            "value": "keyword"
          },
