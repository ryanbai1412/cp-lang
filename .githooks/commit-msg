#!/usr/bin/env bash
# Enforces the commit subject convention in AGENTS.md: `area: summary`.
subject="$(grep -v '^#' "$1" | head -1)"
areas='syntax|check|codegen|interp|stdlib|diag|lsp|editors|fmt|lint|stress|judge|tools|cli|docs|site|design|spec|plan|port|frictions|bench|factory|ci|deps|revert'
case "$subject" in
    Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! grep -qE "^($areas)(\([a-z0-9._/-]+\))?: [^ ].{0,70}$" <<<"$subject"; then
    echo "commit-msg: subject must be \`area: summary\` (at most 72 characters), with area one of:" >&2
    echo "  ${areas//|/, }" >&2
    echo "  e.g. \`stdlib: add interval map\` or \`port(cf2237h): rethink with interval map\`" >&2
    exit 1
fi
# Every commit names its lane (land.sh and the velocity numbers read it). A
# missing trailer is added from $CPL_DOMAIN or the one plan/domains/<d>/ the
# commit touches; when neither says, warn rather than refuse.
if ! git interpret-trailers --parse "$1" | grep -q '^Domain: '; then
    root="$(git rev-parse --show-toplevel)"
    # shellcheck disable=SC2046
    d="$(python3 "$root/scripts/domain_of.py" $(git diff --cached --name-only))"
    if [ -n "$d" ]; then
        git interpret-trailers --in-place --trailer "Domain: $d" "$1"
    else
        echo "commit-msg: no Domain: trailer; add one (e.g. \`Domain: compiler\`) or set CPL_DOMAIN" >&2
    fi
fi
# Every commit names the session lane that landed it, so a counter or a
# verdict traced to a commit reaches its owner without a search.
if ! git interpret-trailers --parse "$1" | grep -q '^Lane: '; then
    if [ -n "${CPL_LANE:-}" ]; then
        git interpret-trailers --in-place --trailer "Lane: $CPL_LANE" "$1"
    else
        echo "commit-msg: no Lane: trailer; add the lane that lands it (e.g. \`Lane: E\`) or set CPL_LANE" >&2
        exit 1
    fi
fi
# A list regeneration's Regressed: trailers are the ones pre-commit's ratchet admitted.
if [ -n "${CPL_REGRESSED:-}" ]; then
    printf '%s\n' "$CPL_REGRESSED" | tr ';' '\n' | while read -r r; do
        [ -n "$r" ] || continue
        git interpret-trailers --parse "$1" | grep -qxF "Regressed: $r" ||
            git interpret-trailers --in-place --trailer "Regressed: $r" "$1"
    done
fi
# A coordinator-signed baseline raise: the Raise: trailers pre-commit's ratchet admitted.
if [ -n "${CPL_RAISE:-}" ]; then
    printf '%s\n' "$CPL_RAISE" | tr ';' '\n' | while read -r r; do
        [ -n "$r" ] || continue
        git interpret-trailers --parse "$1" | grep -qxF "Raise: $r" ||
            git interpret-trailers --in-place --trailer "Raise: $r" "$1"
    done
fi
