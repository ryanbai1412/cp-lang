#!/usr/bin/env bash
# Cheap pre-push gate: rebases skip pre-commit, so verify before pushing that
# no merge-conflict markers slipped in, changed JSON/JSONL files parse, and
# the Rust workspace still compiles.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

fail() { echo "pre-push: $*" >&2; exit 1; }

# The build and ratchet gate only pushes to main; a branch push (shared WIP such as
# lane-j-decls) runs only the cheap checks, no heavier than the commit hook.
to_main=0
to_lane=0
lane_tip=
while read -r _ _ remote_ref remote_sha; do
    [ "$remote_ref" = refs/heads/main ] && to_main=1
    [ "$remote_ref" = refs/heads/lane-j-check ] && to_lane=1 && lane_tip=$remote_sha
done

# 1. Merge conflict markers anywhere in tracked files.
markers=$(git grep -nE '^(<{7}|>{7}|\|{7})( |$)' -- ':!*.png' ':!*.gz' || [ $? = 1 ])
[ -z "$markers" ] || fail "merge conflict markers found in repository:
$markers"

# 2. Validate any JSON/JSONL files touched since origin/main.
if git rev-parse -q --verify origin/main >/dev/null 2>&1; then
    changed_json=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- '*.json' '*.jsonl')
    if [ -n "$changed_json" ]; then
        python3 -c '
import json, sys
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as f:
        if path.endswith(".jsonl"):
            for i, line in enumerate(f, 1):
                if line.strip():
                    try:
                        json.loads(line)
                    except Exception as e:
                        sys.exit(f"{path}:{i}: invalid JSONL: {e}")
        else:
            try:
                json.load(f)
            except Exception as e:
                sys.exit(f"{path}: invalid JSON: {e}")
' $changed_json || fail "invalid JSON/JSONL in unpushed commits"
    fi
fi

# 2b. Formatting, which land.sh checks but a direct push skips (about 1 s).
if [ -f Cargo.toml ] && command -v cargo >/dev/null 2>&1; then
    cargo fmt --all --check >/dev/null 2>&1 || fail "not formatted; run: cargo fmt --all"
fi

# 2a. Only the landing queue (scripts/lane-queue.sh) pushes to lane-j-check, one push at a
# time, so no lane loses a race to another's gate run (coordinator 04:34). A lane hands its
# work in on a queue branch; the gates below run in the queue's push.
if [ "$to_lane" = 1 ] && [ "${CPL_LANE_QUEUE:-}" != 1 ]; then
    fail "hand lane-j-check work to the queue: git push origin HEAD:refs/heads/queue/<lane>-<name> (scripts/lane-queue.sh lands it)"
fi

# 2b'. A lane-j-check tip that doesn't build blocks, so a bisect never meets one (37 such
# first-parent commits cost D's 03:30 bisect): the same check as a push to main. Clippy's
# warnings block in each crate the push touches, so no lane's pre-commit fails on another
# lane's warning (fe900547d and ba676477a held D's push, 04:12).
if [ "$to_lane" = 1 ] && [ -f Cargo.toml ] && command -v cargo >/dev/null 2>&1; then
    cargo check -q --workspace --all-targets || fail "lane-j-check's tip doesn't build: cargo check --workspace --all-targets failed"
    touched=$(scripts/touched-crates.sh "$lane_tip")
    # shellcheck disable=SC2086  # one word per cargo argument
    [ -z "$touched" ] || cargo clippy -q $touched --all-targets -- -D warnings ||
        fail "clippy warns in a crate this push touches: cargo clippy $touched --all-targets -- -D warnings"
fi

# 2c. lane-j-check's landing gate: cpl-next's lib and integration tests and cpl-doc's lib tests, every red listed in
# tests/lane-lib-reds.txt (shrink-only, target 0 before slice 1). CI's lane-check holds a
# `--no-verify` push to it too.
if [ "$to_lane" = 1 ] && [ -f scripts/lane-lib-tests.py ]; then
    python3 scripts/lane-lib-tests.py || fail "lane-j-check's tests (above); fix the red or, if it is not yours, name its owner"
fi

# 2d. lane-j-check's ratchet, shrink-only against the tip this push replaces (coordinator 02:38):
# a counter that rises fails, and so does a new commit with no `Lane:` trailer or a
# `Skipped: ratchet` one. Main's full --check replaces it before the slice-1 switch.
if [ "$to_lane" = 1 ] && [ -f scripts/debt-ratchet.py ] && command -v uv >/dev/null 2>&1; then
    CPL_RATCHET_LANE="$lane_tip" uv run --quiet python scripts/debt-ratchet.py --check ||
        fail "lane-j-check's ratchet (above): remove what rose, or add the commit's Lane: trailer"
fi

[ "$to_main" = 1 ] || exit 0

# 3. Cheap workspace build check (warm ~1-3s) so broken rebases never hit main.
if [ -f Cargo.toml ] && command -v cargo >/dev/null 2>&1; then
    cargo check -q --workspace --all-targets || fail "cargo check --workspace --all-targets failed"
fi

# 4. The ratchet (about 25 s warm). A commit-time run can be cut by its 25 s limit and
# `--no-verify` skips both hooks, so CI's ratchet part holds every main tip to it too.
if [ -f scripts/debt-ratchet.py ] && command -v uv >/dev/null 2>&1; then
    uv run --quiet python scripts/debt-ratchet.py --check || fail "debt-ratchet --check failed (above); fix it before pushing"
fi
