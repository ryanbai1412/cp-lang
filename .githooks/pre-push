#!/usr/bin/env bash
# Cheap pre-push gate: rebases skip pre-commit, so verify before pushing that
# no merge-conflict markers slipped in, changed JSON/JSONL files parse, and
# the Rust workspace still compiles.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

fail() { echo "pre-push: $*" >&2; exit 1; }

# The build and ratchet gate only pushes to main; a branch push (shared WIP such as
# lane-j-decls) runs only the cheap checks, no heavier than the commit hook.
to_main=0 to_lane=0
while read -r _ _ remote_ref _; do
    [ "$remote_ref" = refs/heads/main ] && to_main=1
    [ "$remote_ref" = refs/heads/lane-j-check ] && to_lane=1
done

# 1. Merge conflict markers anywhere in tracked files.
markers=$(git grep -nE '^(<{7}|>{7}|\|{7})( |$)' -- ':!*.png' ':!*.gz' || [ $? = 1 ])
[ -z "$markers" ] || fail "merge conflict markers found in repository:
$markers"

# 2. Validate any JSON/JSONL files touched since origin/main.
if git rev-parse -q --verify origin/main >/dev/null 2>&1; then
    changed_json=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- '*.json' '*.jsonl')
    if [ -n "$changed_json" ]; then
        python3 -c '
import json, sys
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as f:
        if path.endswith(".jsonl"):
            for i, line in enumerate(f, 1):
                if line.strip():
                    try:
                        json.loads(line)
                    except Exception as e:
                        sys.exit(f"{path}:{i}: invalid JSONL: {e}")
        else:
            try:
                json.load(f)
            except Exception as e:
                sys.exit(f"{path}: invalid JSON: {e}")
' $changed_json || fail "invalid JSON/JSONL in unpushed commits"
    fi
fi

# 2a. On every branch: no unadmitted edit to the frozen old pipeline (audit #18 (3)); only
# plan/signoffs.toml, as main holds it, admits one. A push to main or lane-j-check may not edit
# plan/signoffs.toml either (audit #18 (2)): a PR branch carries that edit to its code owner.
if [ -f scripts/debt-ratchet.py ] && git rev-parse -q --verify origin/main >/dev/null 2>&1; then
    if [ "$to_main" = 1 ] || [ "$to_lane" = 1 ]; then authority=--authority; else authority=--frozen; fi
    uv run --quiet python scripts/debt-ratchet.py "$authority" origin/main ||
        fail "an edit to a frozen crate or to plan/signoffs.toml (above) that plan/signoffs.toml doesn't admit"
fi

# 2b. Formatting, which land.sh checks but a direct push skips (about 1 s).
if [ -f Cargo.toml ] && command -v cargo >/dev/null 2>&1; then
    cargo fmt --all --check >/dev/null 2>&1 || fail "not formatted; run: cargo fmt --all"
fi

[ "$to_main" = 1 ] || exit 0

# 3. Cheap workspace build check (warm ~1-3s) so broken rebases never hit main.
if [ -f Cargo.toml ] && command -v cargo >/dev/null 2>&1; then
    cargo check -q --workspace --all-targets || fail "cargo check --workspace --all-targets failed"
fi

# 4. The ratchet (about 25 s warm). A commit-time run can be cut by its 25 s limit and
# `--no-verify` skips both hooks, so CI's ratchet part holds every main tip to it too.
if [ -f scripts/debt-ratchet.py ] && command -v uv >/dev/null 2>&1; then
    uv run --quiet python scripts/debt-ratchet.py --check || fail "debt-ratchet --check failed (above); fix it before pushing"
fi
