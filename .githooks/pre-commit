#!/usr/bin/env bash
# Runs the commit tier of the gate (the checks the staged paths can reach)
# before every commit; CI runs the full fast gate on every main tip.
# A commit never waits more than 25 s on it: past that the hook warns, names
# the step it was in, logs it to .git/cpl-commit-slow.log and allows the
# commit; touched-path slices (scripts/affected.py) a cut skipped are left
# for scripts/land.sh to run before it pushes, so none reaches main unrun. Turn it on once per clone with scripts/install-hooks.sh; skip it
# for one commit with `git commit --no-verify`.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
limit="${CPL_COMMIT_TIMEOUT:-25}"
out="$(mktemp)"
own="$(cd "$(git rev-parse --git-dir)" && pwd)"
# scripts/ci.py lists here the commit-tier steps it has yet to finish.
progress="$own/cpl-commit-progress.$$"
trap 'rm -f "$out" "$progress"' EXIT
CPL_PRE_COMMIT=1 CPL_COMMIT_PROGRESS="$progress" timeout "$limit" "$root/scripts/check.sh" --commit 2>&1 | tee "$out"
status=${PIPESTATUS[0]}
if [ "$status" -ne 124 ]; then
    # land.sh shows this when a failed hook left nothing to land.
    [ "$status" -eq 0 ] || tail -40 "$out" >"$(git rev-parse --git-common-dir)/cpl-commit-failed.log"
    # A failure in a crate main has changed since this base may be fixed there already.
    if [ "$status" -ne 0 ] && git rev-parse -q --verify origin/main >/dev/null; then
        for c in $(grep -oE 'crates/[A-Za-z0-9_-]+/' "$out" | sort -u); do
            git diff --quiet HEAD...origin/main -- "$c" 2>/dev/null ||
                echo "pre-commit: your base is behind origin/main in ${c%/}; if this failure isn't yours, it may be fixed there: git pull --rebase, then commit again" >&2
        done
        behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
        [ "$behind" -eq 0 ] || ! grep -q '^debt-ratchet: ERROR' "$out" ||
            echo "pre-commit: your branch is $behind commits behind origin/main, whose ratchet baseline this tree is measured against; git pull --rebase first, then commit again" >&2
    fi
    exit "$status"
fi
slow=$(grep '^==> ' "$out" | tail -1 | cut -c5-)
printf '%s\t%ss\t%s\n' "$(date -u +%FT%TZ)" "$limit" "${slow:-setup}" >>"$(git rev-parse --git-common-dir)/cpl-commit-slow.log"
# Cut while its slices built or ran: the commit goes in, and land.sh runs
# those slices before it pushes, so they never reach main unrun.
case "$slow" in
    "touched-path slices: "*) slices=${slow#touched-path slices: }; slices=${slices%% (*} ;;
    "build of the touched-path slices' tests: "*) slices=${slow#*tests: } ;;
    *) slices=
       grep -q '^==> touched-path slices: ' "$out" || [ ! -f "$root/scripts/affected.py" ] ||
           slices=$(uv run --quiet python "$root/scripts/affected.py" 2>/dev/null | sed -n 's/^slices=//p') ;;
esac
if [ -n "$slices" ]; then
    printf '%s\n' $slices >>"$own/cpl-pending-slices"
    echo "pre-commit: the touched-path slices ($slices) didn't run; scripts/land.sh runs them before it pushes" >&2
fi
# The commit-tier steps the cut never reached (scripts/ci.py COMMIT_STEPS), such
# as b3b3c30dd's wasm check: land.sh runs them on the rebased tip before it pushes.
if [ -s "$progress" ]; then
    cat "$progress" >>"$own/cpl-pending-steps"
    echo "pre-commit: the commit-tier steps from $(head -1 "$progress") on didn't run; scripts/land.sh runs them before it pushes" >&2
fi
# A cut before or in the staged conformance cases' step lands them unrun (4aaa8b0db);
# land.sh runs them on the rebased tip before it pushes.
cases=$(uv run --quiet python "$root/scripts/affected.py" 2>/dev/null | sed -n 's/^conform_cases=//p')
if [ -n "$cases" ]; then
    printf '%s\n' $cases >>"$own/cpl-pending-cases"
    echo "pre-commit: the staged conformance cases may not have run; scripts/land.sh runs them before it pushes" >&2
fi
echo "pre-commit: WARNING: the commit tier passed ${limit}s in \`${slow:-setup}\`; allowing the commit, CI runs the rest" >&2
exit 0
