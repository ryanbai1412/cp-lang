+/// The `<!-- given: code -->` comment right above a fence: declarations the
+/// block takes from the surrounding prose, prepended when it runs.
+fn given_above(before: &str) -> Option<String> {
+    let trimmed = before.trim_end();
+    let body = trimmed.strip_suffix("-->")?;
+    let open = body.rfind("<!--")?;
+    if trimmed[..open].rsplit('\n').next().is_some_and(|l| !l.trim().is_empty()) {
+        return None;
+    }
+    let code = body[open + 4..].trim_start().strip_prefix("given:")?;
+    let code = code.trim();
+    (!code.is_empty()).then(|| format!("{code}\n"))
+}
+
+/// Like `extract_blocks`, but also takes bare fences and each block's
+/// `given:` prelude. Used for `spec/core`, whose bare fences are CP code.
+pub fn extract_blocks_with_given(text: &str, bare: bool) -> Vec<(String, Option<String>)> {
+    let mut blocks = Vec::new();
+    let mut pos = 0;
+    while let Some(rel) = text[pos..].find("```") {
+        let open = pos + rel;
+        let after = &text[open + 3..];
+        let Some(nl) = after.find('\n') else {
+            break;
+        };
+        let lang = after[..nl].trim();
+        let body_start = &after[nl + 1..];
+        let Some(close) = body_start.find("```") else {
+            break;
+        };
+        if lang == "cp" || lang == "python" || (bare && lang.is_empty()) {
+            blocks.push((body_start[..close].to_string(), given_above(&text[..open])));
+        }
+        pos = open + 3 + nl + 1 + close + 3;
+    }
+    blocks
+}
