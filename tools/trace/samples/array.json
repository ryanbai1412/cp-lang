{
  "schemaVersion": 1,
  "title": "Insertion sort",
  "description": "An in-place array, a moving boundary, and every write made visible.",
  "source": {
    "file": "sort.cp",
    "code": "fn insertion_sort(a):\n    for i in 1..a.len:\n        let key = a[i]\n        var j = i\n        while j > 0 and a[j - 1] > key:\n            a[j] = a[j - 1]\n            j -= 1\n        a[j] = key\n    a\n"
  },
