// expect: ok, output "YES YES\nYES YES\nYES YES YES\nYES YES\nYES YES\nYES YES YES"
use std.slope.{Concave, Convex}
var a = Concave.flat(0..=4)
a.add_left(2)
var b = Concave.flat(0..=4)
b.add_right(2)
print(yes(a.at(0) == -2 and a.at(3) == 0), yes(b.at(4) == -2 and b.at(1) == 0))
var c = Concave.flat(0..=4)
c.add_abs(1)
var d = Concave.point(2)
d.add_const(-4)
print(yes(c.at(0) == -1 and c.at(4) == -3), yes(d.at(2) == -4))
var e = Concave.flat(0..=4)
e.add_linear(2)
var g = Concave.point(0)
g.add_const(7)
g.shift(5)
var h = Concave.flat(0..=4)
h.add_left(-3)
h.add_right(9)
print(yes(e.at(3) == 6 and e.at(0) == 0), yes(g.lo == 5 and g.at(5) == 7), yes(h.at(4) == 0 and h.at(0) == 0))
var x = Convex.flat(0..=4)
x.add_left(2)
var y = Convex.flat(0..=4)
y.add_right(2)
print(yes(x.at(0) == 2 and x.at(3) == 0), yes(y.at(4) == 2 and y.at(1) == 0))
var z = Convex.flat(0..=4)
z.add_abs(1)
z.add_const(3)
var w = Convex.flat(0..=4)
w.add_linear(-2)
print(yes(z.at(4) == 6 and z.min() == 3), yes(w.at(4) == -8))
var q = Convex.point(1)
q.shift(-1)
var r = Concave.flat(-2..=2)
r.add_abs(0)
r.add_linear(1)
print(yes(q.lo == 0 and q.at(0) == 0), yes(r.at(-2) == -4 and r.at(0) == 0), yes(r.at(2) == 0 and r.max() == 0))
