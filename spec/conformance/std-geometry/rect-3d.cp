print(Pt3(1, 2, 2).norm2, Pt3(1, 2, 2).norm2_128 == I128(9), Pt3(1, 2, 2).len == 3.0, Pt3(1, 2, 2).to_vec3 == Vec3(1.0, 2.0, 2.0), Pt3(1, 2, 3).dot(Pt3(4, 5, 6)), Pt3(1, 2, 3).dot128(Pt3(4, 5, 6)) == I128(32) and Pt3(1, 0, 0).cross(Pt3(0, 1, 0)) == Pt3(0, 0, 1), Pt3(1, 2, 3).cross(Pt3(4, 5, 6)).x, Pt3(1, 2, 3).cross(Pt3(4, 5, 6)).y, Pt3(1, 2, 3).cross(Pt3(4, 5, 6)).z, Pt3(0, 0, 0).dist2(Pt3(1, 2, 2)), Pt3(0, 0, 0).dist(Pt3(1, 2, 2)) == 3.0, Pt3(1, 1, 1).manhattan(Pt3(2, -1, 4)), Pt3(1, 1, 1).chebyshev(Pt3(2, -1, 4)))
