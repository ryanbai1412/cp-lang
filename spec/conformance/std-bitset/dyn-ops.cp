// expect: ok, output "0 2\n2\n0 1 3\n1 3\nYES\n3 5\n1 6\n1 3 5 8\n8 3 1\n0 2 3 5 7 8 10"
use std.bitset.{DynBitset}
var a = DynBitset(4)
a.add(0)
var b = DynBitset(4)
b.add(2)
a.union(b)
print([i for i in a.each()])
var c = DynBitset.full(4)
c.intersect(b)
print([i for i in c.each()])
var e = DynBitset.full(4)
e.subtract(b)
print([i for i in e.each()])
var g = DynBitset(4)
g.add(1)
g.add(2)
var h = DynBitset(4)
h.add(2)
h.add(3)
g.symmetric(h)
print([i for i in g.each()])
var m = DynBitset(4)
m.add(1)
print(m.meets(DynBitset.full(4)) and not m.meets(DynBitset(4)))
var u = DynBitset(10)
u.add(1)
u.add(3)
u.add(8)
var v = DynBitset(10)
v.add(1)
v.add(3)
v.add(8)
var o = DynBitset(10)
o.add(1)
o.add(3)
o.add(8)
u.shift_up(2)
v.shift_down(2)
o.shift_or(2)
print([i for i in u.each()])
print([i for i in v.each()])
print([i for i in o.each()])
var q = DynBitset(10)
q.add(1)
q.add(3)
q.add(8)
print([i for i in q.each_rev()])
print([i for i in DynBitset.subset_sums(11, [2, 3, 5]).each()])
