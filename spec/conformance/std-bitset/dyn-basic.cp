// expect: ok, output "0 10 10 2 YES\n5\n7\n1 4\n0 1"
use std.bitset.{DynBitset}
var d = DynBitset(10)
d.add(1)
d.add(3)
var e = DynBitset(10)
let x = e.add(2)
let y = e.add(2)
let z = e.remove(2)
let w = e.remove(2)
print(DynBitset(10).len, DynBitset.full(10).len, DynBitset(10).cap, d.len, d.contains(3) and not d.contains(4) and x and not y and z and not w and e.is_empty and DynBitset(10).is_empty and not DynBitset.full(1).is_empty)
var s = DynBitset(10)
s.set(4)
s.set(5, true)
s.set(4, false)
print([i for i in s.each()])
var t = DynBitset(10)
t.toggle(6)
t.toggle(6)
t.toggle(7)
print([i for i in t.each()])
var r = DynBitset(10)
r.add(1)
r.add(8)
r.resize(4)
print(r.len, r.cap)
var f = DynBitset.full(2)
f.resize(5)
print([i for i in f.each()])
