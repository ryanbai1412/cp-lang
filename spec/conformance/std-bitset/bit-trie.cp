// expect: ok, output "YES 3 1 0\n2 2\n1 2\n0 1\nYES 7 2 0\nYES"
use std.bitset.{BitTrie, BitTrieArena}
var ar = BitTrieArena<3>()
var t = BitTrie<3>.of(mut ar, 5)
t.add(mut ar, 4)
t.add(mut ar, 1)
print(yes(not t.is_empty and BitTrie<3>.new().is_empty), t.len(ar), t.count(ar, 5), t.count(ar, 7))
for (bit, count) in t.walk(ar, 5): print(bit, count)
var u = BitTrie<3>.of(mut ar, 5)
u.add(mut ar, 2)
u.add(mut ar, 2)
var big = BitTrie<3>.of(mut ar, 6)
big.absorb(mut ar, mut t)
u.absorb(mut ar, mut big)
print(yes(t.is_empty and big.is_empty), u.len(ar), u.count(ar, 2), u.count(ar, 4) - 1)
var e = BitTrie<3>.new()
e.absorb(mut ar, mut u)
print(yes(e.len(ar) == 7 and u.is_empty and e.count(ar, 5) == 2 and e.count(ar, 6) == 1))
