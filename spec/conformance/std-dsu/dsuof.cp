// expect: ok, output "YES\nYES\nYES\nYES\n1 2\n2 4\nYES\n0 2\n1"
domain V = 0..3
var d = DsuOf<V, Int>(init: v => v.ord + 1, join: (x, y) => x + y)
d.unite(V(0), V(2))
print(d.get(V(2)) == 4 and d.get(V(1)) == 2 and d.components == 2)
var e = DsuOf<V, Int>(init: v => v.ord, join: (_, y) => y)
e.unite(V(2), V(0))
print(e.get(V(2)) == 0 and e.find(V(0)) == V(2))
var f = DsuOf<V, Int>(init: v => v.ord, join: (x, y) => x + y)
print(f.merge(V(2), V(1)) == Some((kept: V(2), merged: V(1))))
print(f.unite(V(0), V(1)) and not f.unite(V(1), V(0)) and f.get(V(0)) == 3)
var g = DsuOf<V, Int>(init: v => v.ord + 1, join: (x, y) => x + y)
g.unite(V(2), V(0))
print([r for r in g.roots()])
print([x for x in g.values])
let m = g.mark()
g.unite(V(0), V(1))
g.set(V(0), 9)
g.undo_to(m)
print(g.get(V(0)) == 4 and g.get(V(1)) == 2)
print(g.groups())
