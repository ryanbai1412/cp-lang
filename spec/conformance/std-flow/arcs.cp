// expect: ok, output "YES\nYES\nYES\nYES\nYES\nYES\nYES\nYES"
use std.flow.{FlowGraph, CostFlow}
domain V2 = 0..2
domain V3 = 0..3
domain V4 = 0..4
var g = FlowGraph<V2>()
let a = g.add(V2(0), V2(1), Some(5))
print(yes(g.source(a.rev) == V2(1) and a.rev.rev == a))
g.max_flow(V2(0), V2(1), limit: Some(2))
print(yes(g.residual(a) == 3 and g.residual(a.rev) == 2))
var h = FlowGraph<V2>()
let b = h.add(V2(0), V2(1), Some(2))
h.max_flow(V2(0), V2(1))
h.set_cap(b, Some(5))
print(yes(h.max_flow(V2(0), V2(1)) == 3))
var k = FlowGraph<V3>()
let c = k.add(V3(0), V3(1), Some(1))
let d = k.add(V3(1), V3(2), Some(1))
let e = k.add(V3(0), V3(2), Some(1))
print(yes([x for x in k.arcs] == [c, d, e] and [x for x in k.out(V3(0))] == [c, e]))
var m = FlowGraph<V3>()
m.add(V3(0), V3(1), Some(5))
let f = m.add(V3(1), V3(2), Some(1))
m.max_flow(V3(0), V3(2))
print(yes(m.cut_arcs(V3(0)) == [f]))
var p = FlowGraph<V4>()
let p1 = p.add(V4(0), V4(1), Some(1))
let p2 = p.add(V4(1), V4(3), Some(1))
let p3 = p.add(V4(0), V4(2), Some(1))
let p4 = p.add(V4(2), V4(3), Some(1))
p.max_flow(V4(0), V4(3))
print(yes([x for x in p.paths(V4(0), V4(3))] == [(arcs: [p1, p2], amount: 1), (arcs: [p3, p4], amount: 1)]))
var q = FlowGraph<V4>()
let q1 = q.add(V4(0), V4(1), Some(3))
let q2 = q.add(V4(1), V4(2), Some(3))
let q3 = q.add(V4(2), V4(1), Some(3))
let q4 = q.add(V4(1), V4(3), Some(3))
q.max_flow(V4(0), V4(3))
q.set_cap(q2, Some(3))
print(yes([x for x in q.paths(V4(0), V4(3))] == [(arcs: [q1, q4], amount: 3)] and q.flow(q3) == 0))
var cf = CostFlow<V4>()
cf.add(V4(0), V4(1), Some(2), 1)
cf.add(V4(0), V4(2), Some(2), 5)
let r = cf.add(V4(1), V4(3), Some(1), 1)
cf.add(V4(2), V4(3), Some(3), 1)
cf.add(V4(1), V4(2), Some(2), 1)
cf.set_cap(r, Some(4))
print(yes(cf.cap(r) == 4 and cf.flow(r) == 0 and [x for x in cf.arcs].len == 5))
