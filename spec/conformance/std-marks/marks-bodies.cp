// expect: ok, output "2 NO\n0 YES\n2 NO\n0 YES\nYES YES NO YES YES\n3 YES NO\nYES NO\n4\n1\nYES NO"
use std.marks.{Marks, MarkMap, SparseSet}
domain D = 0..5
var m = Marks<D>()
m.add(D(1))
m.add(D(3))
m.add(D(1))
print(m.len, yes(m.is_empty))
m.remove(D(1))
m.remove(D(3))
print(m.len, yes(m.is_empty))
var mm = MarkMap<D, Int>(0)
mm.set(D(1), 7)
mm.set(D(1), 8)
mm.set(D(4), 0)
print(mm.len, yes(mm.is_empty))
mm.clear()
print(mm.len, yes(mm.is_empty))
var s = SparseSet<D>()
print(yes(s.is_empty), yes(s.add(D(3))), yes(s.add(D(3))), yes(s.add(D(1))), yes(s.add(D(4))))
print(s.len, yes(s.contains(D(3))), yes(s.contains(D(2))))
print(yes(s.remove(D(3))), yes(s.remove(D(3))))
for v in s.each(): print(Int(v))
s.clear()
print(yes(s.is_empty), yes(s.contains(D(4))))
