// Synthesis #2 rule 6: Char + Int -> Char (checked ASCII), the inverse of Char - Char.
let digit: 0..=9 = read()
let c = 'a' + 2
let row = [0, 1, 2, 3, 4]
print(c, '0' + digit, 'z' - 25, 'c' - 'a', ('a' + 5) - 'a')
print(Str('0' + d for d in row), Str(['A' + d for d in row]))
var s = ""
for d in row: s += 'a' + d * 2
print(s)
